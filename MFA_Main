''' MFA Project test 1'''
def advanced_password():
    flag = 0
    username = input("Enter Username: ")
    password = input("Enter Password: ")
    if (password.islower() is False) and (password.isalnum() is False) and (password.isspace() is False) and (len(password) >= 8):
        has_number = False
        for char in password:
            if not char.isnumeric():
                has_number = True
                break
        if has_number is True:
            flag = 1
        elif has_number is False:
            print("make sure your password is more than 8 characters and has a capital letter, a number, a special character and no spaces in them")
            advanced_password()
    if flag == 1:
        userbase = {"Username": username,
                    "Password": password}
        print(userbase)
    if flag == 0:
        print("make sure your password is more than 8 characters and has a capital letter, a number, a special character and no spaces in them")
        advanced_password()


advanced_password()

'''GUI code'''
import customtkinter as tk
tk.set_appearance_mode("dark")
tk.set_default_color_theme("dark-blue")
def login():
    root = tk.CTk()
    width = root.winfo_screenwidth()
    height = root.winfo_screenheight()
    root.geometry("900x600")
    root.title("Login")
    frame = tk.CTkFrame(master=root)
    frame.pack(pady=20,padx=20, fill="both", expand=True)
    title_label = tk.CTkLabel(master=frame,text="Login", font=("Roboto", 24))
    title_label.pack(pady=10, padx=10)
    loginframe = tk.CTkFrame(master=frame)
    loginframe.pack(pady=25, padx=300,fill="both", expand=True)
    user_label = tk.CTkLabel(master=loginframe, text="Username:", font=("Roboto", 14))
    user_label.pack(padx=10)
    user_entry = tk.CTkEntry(master=loginframe, placeholder_text="Username")
    user_entry.pack(padx=10)
    pass_label = tk.CTkLabel(master=loginframe, text="Password:", font=("Roboto", 14))
    pass_label.pack(padx=10)
    pass_entry = tk.CTkEntry(master=loginframe, placeholder_text="Password", show="*")
    pass_entry.pack(padx=10)
    error_label = tk.CTkLabel(master=loginframe, text = "Error", text_color="red")
    error_label.pack(padx=10)
    login_button = tk.CTkButton(master=loginframe, text="Login")
    login_button.pack(pady=10,padx=10)
    signup_button = tk.CTkButton(master=loginframe, text="Create user")
    signup_button.pack(pady=10, padx=10)
    root.mainloop()
