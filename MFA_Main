                    "Password": password}
        print(userbase)
    if flag == 0:
        print("make sure your password is more than 8 characters and has a capital letter, a number, a special character and no spaces in them")
        advanced_password()


advanced_password()

'''GUI code'''
def logingui():
    import tkinter as tk
    ParentWindow = tk.Tk(className="Python Project")
    ParentWindow.geometry("600x250")
    main_frame = tk.Frame(ParentWindow, width=600, height=250)
    main_frame.pack(fill=tk.BOTH,side=tk.LEFT,expand=True)
    user_label = tk.Label(master=main_frame, text="Username")
    user_label.pack(pady=10)
    user_entry = tk.Entry(master=main_frame)
    user_entry.pack(pady=10)
    pass_label = tk.Label(master=main_frame, text="Password")
    pass_label.pack(pady=10)
    pass_entry = tk.Entry(master=main_frame, show="*")
    pass_entry.pack(pady=10)
    error_label = tk.Label(master=main_frame, text="Error", fg="Red")
    error_label.pack(pady=10)
    login_button = tk.Button(master=main_frame, text="Login")
    login_button.pack(pady=10)
    tk.mainloop()
logingui()

'''Time-based Authentication'''
def Time():
  import datetime
  current_datetime=datetime.datetime.now()    #Check System Clock Synchronization
  curr_hr=current_datetime.hour
  curr_min=current_datetime.minute
  current_date=datetime.date.today()
  current_year = current_date.year
  current_month = current_date.month
  current_day = current_date.day
  hour=int(input("\nEnter the usual hour:"))
  min=int(input("\nEnter the usual hour:"))
  time1=datetime.datetime(current_year,current_month,current_day,curr_hr,curr_min)
  time2=datetime.datetime(current_year,current_month,current_day,(hour+1)%24,(min+30)%60) #cut him some slack....like 30 mins
  time3=datetime.datetime(current_year,current_month,current_day,hour,min)
  time4=datetime.datetime(current_year,current_month,current_day,(hour-1)%24,(min+30)%60)

  if(time1>time2):
    print("\nAccess Denied")
  elif(time1>=time4 and time1<=time2):
    print("\nWelcome")
  else:
    print("\nGet the hell out!")
Time()
